{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev --port 7777",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "electron:dev": "nuxt dev --port 7777 & sleep 5 && electron .",
    "electron:build": "nuxt build && electron-builder",
    "electron:build:mac": "nuxt build && electron-builder --mac",
    "electron:build:win": "nuxt build && electron-builder --win"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.41.5",
    "@vueuse/core": "^13.1.0",
    "@vueuse/motion": "^2.2.6",
    "better-sqlite3": "^11.9.1",
    "chart.js": "^4.4.9",
    "chokidar": "^4.0.3",
    "node-pty": "^1.2.0-beta.13",
    "nuxt": "3.17.5",
    "simple-git": "^3.27.0",
    "vue": "^3.5.16",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.21",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.cortex.app",
    "productName": "CORTEX",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".output/server",
        "to": "server"
      },
      {
        "from": ".output/public",
        "to": "public"
      },
      {
        "from": "app/public/icon-512.png",
        "to": "icon-512.png"
      },
      {
        "from": "scoop-brain.db",
        "to": "scoop-brain.db",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3"
      },
      {
        "from": "node_modules/bindings",
        "to": "node_modules/bindings"
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "node_modules/file-uri-to-path"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "app/public/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "app/public/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "app/public/icon-512.png",
      "uninstallerIcon": "app/public/icon-512.png"
    }
  }
}
